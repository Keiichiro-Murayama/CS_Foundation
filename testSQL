-- ============================================================
-- ⑦ 確認SQL
-- ============================================================

-- 件数確認
SELECT 'category' AS table_name, COUNT(*) FROM category
UNION ALL
SELECT 'book', COUNT(*) FROM book
UNION ALL
SELECT 'book_stock', COUNT(*) FROM book_stock
UNION ALL
SELECT 'users', COUNT(*) FROM users;

-- JOIN確認（超重要）
SELECT
  b.title,
  b.author,
  c.name AS category,
  bs.stock
FROM book b
JOIN category c ON b.category_id = c.id
JOIN book_stock bs ON b.id = bs.book_id
ORDER BY b.id;


