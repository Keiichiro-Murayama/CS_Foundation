-- ============================================================
-- ① データベース作成
-- ============================================================
CREATE DATABASE library_db
WITH
OWNER = postgres
ENCODING = 'UTF8'
CONNECTION LIMIT = -1;

-- 作成後は library_db に接続して実行すること


-- ============================================================
-- ② テーブル作成
-- ============================================================

-- category
CREATE TABLE category (
  id SERIAL NOT NULL,
  category_uuid VARCHAR(36) NOT NULL,
  name VARCHAR(20) NOT NULL,
  created_at TIMESTAMP NOT NULL,
  updated_at TIMESTAMP NOT NULL,
  CONSTRAINT pk_category PRIMARY KEY (id),
  CONSTRAINT uk_category_uuid UNIQUE (category_uuid)
);

-- book
CREATE TABLE book (
  id SERIAL NOT NULL,
  book_uuid VARCHAR(36) NOT NULL,
  title VARCHAR(50) NOT NULL,
  author VARCHAR(30) NOT NULL,
  category_id INTEGER NOT NULL,
  created_at TIMESTAMP NOT NULL,
  updated_at TIMESTAMP NOT NULL,
  CONSTRAINT pk_book PRIMARY KEY (id),
  CONSTRAINT uk_book_uuid UNIQUE (book_uuid),
  CONSTRAINT fk_book_category
    FOREIGN KEY (category_id) REFERENCES category(id)
);

-- book_stock
CREATE TABLE book_stock (
  id SERIAL NOT NULL,
  stock_uuid VARCHAR(36) NOT NULL,
  stock INTEGER NOT NULL,
  book_id INTEGER NOT NULL,
  created_at TIMESTAMP NOT NULL,
  updated_at TIMESTAMP NOT NULL,
  CONSTRAINT pk_book_stock PRIMARY KEY (id),
  CONSTRAINT uk_book_stock_uuid UNIQUE (stock_uuid),
  CONSTRAINT uk_book_stock_book UNIQUE (book_id),
  CONSTRAINT fk_book_stock_book
    FOREIGN KEY (book_id) REFERENCES book(id),
  CONSTRAINT chk_stock_non_negative CHECK (stock >= 0)
);

-- users
CREATE TABLE users (
  id SERIAL NOT NULL,
  user_uuid VARCHAR(36) NOT NULL,
  username VARCHAR(30) NOT NULL,
  password VARCHAR(255) NOT NULL,
  created_at TIMESTAMP NOT NULL,
  updated_at TIMESTAMP NOT NULL,
  CONSTRAINT pk_users PRIMARY KEY (id),
  CONSTRAINT uk_users_uuid UNIQUE (user_uuid),
  CONSTRAINT uk_users_username UNIQUE (username)
);


